# Required — the pipeline cannot run without this.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — comma-separated origins. Defaults to allowing all (fine for local dev).
# CORS_ORIGIN=https://your-frontend.up.railway.app

PORT=4000

# Optional model overrides. Both default to claude-opus-5.
# Swap the extraction tier if rate limits or cost bite — this is the one-line swap.
# EXTRACTION_MODEL=claude-haiku-4-5
# NARRATIVE_MODEL=claude-opus-5
