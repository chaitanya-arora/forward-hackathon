# Local configuration: enter your key in .env, never in this template.
GEMINI_API_KEY=
AGENT2_MODEL=gemini-3.6-flash
AGENT1_MODEL=gemini-3.6-flash
# Independent chunks per classification request (1-16); default 8.
AGENT1_BATCH_SIZE=8
AASB_MODEL=gemini-3.6-flash
# One process shares this pacing across extraction and both report generators.
GEMINI_MIN_REQUEST_INTERVAL_MS=15000
GEMINI_MAX_RETRIES=3
GEMINI_MAX_RETRY_DELAY_MS=60000
